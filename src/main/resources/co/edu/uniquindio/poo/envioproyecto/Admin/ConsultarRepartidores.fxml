                <TableColumn fx:id="colMetodoPago" prefWidth="75.0" text="Metodo pago" />
            </columns>
        </TableView>
        <Button fx:id="BtnActualizae" layoutX="45.0" layoutY="75.0" mnemonicParsing="false" onAction="#OnActualizar" text="Actualizar" />
        <Button fx:id="BtnEliminar" layoutX="119.0" layoutY="75.0" mnemonicParsing="false" onAction="#OnEliminar" text="Eliminar" />
        <Button fx:id="BtnAgregar" layoutX="195.0" layoutY="75.0" mnemonicParsing="false" onAction="#OnAgregar" text="Agregar" />
        <Button fx:id="BtnVolver" layoutX="512.0" layoutY="26.0" mnemonicParsing="false" onAction="#OnVolver" text="Volver" />
