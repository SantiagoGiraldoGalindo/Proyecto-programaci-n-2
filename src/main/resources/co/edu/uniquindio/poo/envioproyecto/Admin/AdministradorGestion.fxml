<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="350.0" prefWidth="608.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.envioproyecto.ViewController.Admin.AdministradorGestionViewController">
   <children>
      <VBox alignment="TOP_CENTER" prefWidth="560.0" spacing="18.0">
         <children>
            <HBox spacing="12.0" />
         </children>
      </VBox>
      <Button fx:id="BtnVolver" layoutX="279.0" layoutY="278.0" mnemonicParsing="false" onAction="#OnVolver" styleClass="primary-button" text="Volver" />
      <Button fx:id="BtnPanel" layoutX="235.0" layoutY="211.0" mnemonicParsing="false" onAction="#OnPanel" prefHeight="26.0" prefWidth="138.0" styleClass="primary-button" text="Panel de métricas" />
      <HBox layoutX="70.0" layoutY="148.0" spacing="12.0">
         <children>
            <Button fx:id="BtnGestionarU" mnemonicParsing="false" onAction="#OnGestionarU" prefHeight="26.0" prefWidth="150.0" styleClass="primary-button" text="Gestionar Usuarios" />
            <Button fx:id="BtnGestionarR" mnemonicParsing="false" onAction="#OnGestionarR" styleClass="primary-button" text="Gestionar Repartidores" />
            <Button fx:id="BtnGestionarE" mnemonicParsing="false" onAction="#OnGestionarE" prefHeight="26.0" prefWidth="127.0" styleClass="primary-button" text="Gestionar Envios" />
         </children>
      </HBox>
      <Label layoutX="215.0" layoutY="78.0" styleClass="title-label" text="Panel de administración" />
   </children>
</AnchorPane>
