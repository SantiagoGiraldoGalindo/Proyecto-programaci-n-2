<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="co.edu.uniquindio.poo.envioproyecto.ViewController.InicioViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
   <Label text="Bienvenido">
      <font>
         <Font size="18.0" />
      </font>
   </Label>
   <AnchorPane prefHeight="227.0" prefWidth="566.0">
      <children>
         <Button fx:id="BtnUsuario" layoutX="98.0" layoutY="114.0" mnemonicParsing="false" onAction="#OnRegistroUsuario" text="Usuario" />
         <Button fx:id="BtnAdministrador" layoutX="257.0" layoutY="114.0" mnemonicParsing="false" onAction="#OnloginAdministrador" text="Administrador" />
         <Button fx:id="BtnRepartidor" layoutX="422.0" layoutY="114.0" mnemonicParsing="false" onAction="#OnLoginRepartidor" text="Repartidor" />
         <Label layoutX="235.0" layoutY="31.0" prefHeight="27.0" prefWidth="104.0" text="¿Que soy?">
            <font>
               <Font size="18.0" />
            </font>
         </Label>
      </children>
   </AnchorPane>
</VBox>
