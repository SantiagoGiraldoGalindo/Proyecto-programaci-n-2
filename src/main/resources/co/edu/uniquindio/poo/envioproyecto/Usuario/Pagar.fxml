<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.envioproyecto.ViewController.Usuario.PagarViewController">
    <children>
        <Label text="Formulario de Pago" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <HBox spacing="10.0">
            <children>
                <Label text="Método de Pago:" />
                <ComboBox fx:id="comboMetodoPago" prefWidth="150.0" promptText="Selecciona método" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label text="Monto: $" />
                <TextField fx:id="txtMonto" prefWidth="100.0" promptText="Ej. 150.0" />
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <Label text="Fecha (YYYY-MM-DD):" />
                <TextField fx:id="txtFecha" prefWidth="150.0" promptText="Ej. 2025-11-12" />
            </children>
        </HBox>
        <Button fx:id="BtnProcesarPago" mnemonicParsing="false" onAction="#OnProcesarPago" text="Procesar Pago" />
        <Label fx:id="lblResultado" style="-fx-text-fill: blue;" text="Selecciona método, ingresa monto y fecha." />
        <TableView fx:id="tablePagos" prefHeight="150.0" prefWidth="400.0">
            <columns />
        </TableView>
        <HBox spacing="10.0">
            <children>
                <Button fx:id="BtnVolver" mnemonicParsing="false" onAction="#OnVolver" text="Volver" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <spacing>15.0</spacing>
</VBox>